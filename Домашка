class Кішка:
    def __init__(self, name, age, length):
        self.name = name
        self.age = age
        self.length = length


    def setAge(self, age):
        if age > 100:
            return
        self.age = age


    def print(self):
        print(f"Кішка {self.name}, вік {self.age} років, довжина {self.length} см\n")

    def __str__(self):
        print(f"Кішка {self.name}, вік {self.age} років, довжина {self.length} см\n")


    def grow(self):
        if self.length + 10 < 70:
            self.length += 10


кішка1 = Кішка("Умка", 9, 50)
кішка1.setAge(10)
print(кішка1)
